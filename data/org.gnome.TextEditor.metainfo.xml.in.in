<?xml version="1.0" encoding="UTF-8"?>
<component type="desktop-application">
	<id>@app_id@</id>
	<metadata_license>CC0-1.0</metadata_license>
	<project_license>GPL-3.0-or-later</project_license>
  <developer id="org.gnome">
    <name>The GNOME Project</name>
  </developer>
  <launchable type="desktop-id">@app_id@.desktop</launchable>
  <name>Text Editor Extended</name>
  <project_group>GNOME</project_group>
  <summary>Edit text files and browse directory workspaces</summary>
  <description>
    <p>GNOME Text Editor Extended is a fork of GNOME Text Editor adding native directory workspaces, recursive asynchronous folder tree navigation, and Markdown dual-mode preview editing.</p>
	</description>

  <url type="homepage">https://apps.gnome.org/TextEditor/</url>
  <url type="bugtracker">https://gitlab.gnome.org/GNOME/gnome-text-editor/issues</url>
  <url type="donation">https://www.gnome.org/donate/</url>
  <url type="vcs-browser">https://gitlab.gnome.org/GNOME/gnome-text-editor</url>
  <url type="contribute">https://welcome.gnome.org/app/TextEditor/</url>
  <url type="translate">https://l10n.gnome.org/module/gnome-text-editor/</url>

  <screenshots>
    <screenshot type="default">
      <image>https://static.gnome.org/appdata/gnome-43/text-editor/text-editor-1.png</image>
      <caption>Text Editor's main window</caption>
    </screenshot>
    <screenshot>
      <image>https://static.gnome.org/appdata/gnome-43/text-editor/text-editor-2.png</image>
      <caption>Syntax highlighting</caption>
    </screenshot>
  </screenshots>

  <branding>
    <color type="primary" scheme_preference="light">#e2dfd6</color>
    <color type="primary" scheme_preference="dark">#676759</color>
  </branding>

  <content_rating type="oars-1.1"/>

  <translation type="gettext">gnome-text-editor</translation>

  <requires>
    <display_length compare="ge">360</display_length>
    <internet>offline-only</internet>
  </requires>

  <supports>
    <control>pointing</control>
    <control>keyboard</control>
    <control>touch</control>
  </supports>

  <releases>
    <release version="51.0-folder.1" date="2026-10-25" type="stable">
      <description>
        <p>First official release of GNOME Text Editor Extended, featuring native workspace directory browsing:</p>
        <ul>
          <li>Integrated asynchronous recursive folder tree panel in sidebar</li>
          <li>Real-time case-folded file and folder search filtering</li>
          <li>Multi-vector directory opening (CLI, GUI menu, keyboard shortcuts Ctrl+Shift+O / Ctrl+Shift+E)</li>
          <li>Workspace session persistence restoring active folder path and sidebar state</li>
        </ul>
      </description>
    </release>
    <release version="51.0" date="2026-09-14" type="development"/>
  </releases>
</component>
